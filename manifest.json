{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.1.0",
  "description": "Bloqueo local de sitios y sincronización del perfil Chromebook con Firebase.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Focus Guard",
    "default_popup": "popup.html"
  }
}
