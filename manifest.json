{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "4.0.7",
  "description": "Registro inicial de alumnos por colegio y clase, con perfil bloqueado desde el panel.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Focus Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/focus-guard-icon.png",
      "32": "assets/focus-guard-icon.png"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "assets/focus-guard-icon.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/focus-guard-icon.png",
    "32": "assets/focus-guard-icon.png",
    "48": "assets/focus-guard-icon.png",
    "128": "assets/focus-guard-icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "iframe-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
