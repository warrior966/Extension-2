{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "2.2.4",
  "description": "Identidad visual renovada y control web con políticas por aula y sincronización Firebase.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Focus Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/focus-guard-icon.png",
      "32": "assets/focus-guard-icon.png"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "assets/focus-guard-icon.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/focus-guard-icon.png",
    "32": "assets/focus-guard-icon.png",
    "48": "assets/focus-guard-icon.png",
    "128": "assets/focus-guard-icon.png"
  }
}
