# Copy to .env locally. Never commit real credentials or secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3030
DATABASE_PATH=./.data/focusguard.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Production:
# NODE_ENV=production
# HOST=127.0.0.1
# Set SESSION_SECRET to a cryptographically random secret.
# Put the app behind a correctly configured HTTPS reverse proxy.
# Do not expose this development prototype directly to the Internet.